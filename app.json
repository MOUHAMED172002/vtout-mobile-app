{
  "expo": {
    "name": "Vtout",
    "slug": "vtout-mobile-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "vtout",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0054a6"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vtout.mobile"
    },
    "android": {
      "package": "com.vtout.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0054a6",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "config": {
        "googleMaps": {
          "apiKey": ""
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#f37021"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Vtout a besoin d'accéder à vos photos pour choisir une image (produit, avatar, pièce d'identité...).",
          "cameraPermission": "Vtout a besoin de la caméra pour prendre une photo (pièce d'identité, produit, avatar...)."
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://api.vtout.com/api",
      "googleWebClientId": "848866935575-avgfnj9g10jt7qbrkm7k1sj33lcsl646.apps.googleusercontent.com",
      "googleIosClientId": "",
      "googleAndroidClientId": ""
    }
  }
}
